---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isSectionVisible } from "../lib/settings";
import {
  intro,
  filmSections,
  culture,
  creatorGroups,
  books,
  siteGroups,
  quotes,
  quoteFootnote,
} from "../data/bicycles";

const tocSections = [
  { id: "films", label: "Films" },
  { id: "culture", label: "Bicycle Culture" },
  { id: "creators", label: "Creators" },
  { id: "books", label: "Books" },
  { id: "websites", label: "Websites" },
  { id: "quotes", label: "Quotes" },
];

if (!(await isSectionVisible(env?.DB, "bicycles"))) {
  return Astro.rewrite("/404");
}
---

<BaseLayout
  title="Bicycle Resources"
  description="Films, books, riders, and sites worth your time, from someone who rides gravel, mountain, and dirt jumps."
  wide
>
  <div class="bike-intro">
    <h1>Bicycle Resources</h1>
    {intro.map((p, i) =>
      i === 0 ? <p class="lede">{p}</p> : <p class="bike-intro__p">{p}</p>
    )}
  </div>

  <nav class="bike-toc" aria-label="Sections">
    <ul>
      {tocSections.map((s) => (
        <li><a href={`#${s.id}`} data-toc={s.id}>{s.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Films keep a single reading-width column: they are prose, not a list. -->
  <section class="bike-section" id="films" aria-labelledby="films-h">
    <h2 id="films-h">Films</h2>
    {filmSections.map((s) => (
      <div class="bike-subsection">
        <h3>{s.heading}</h3>
        {s.blurb && <p class="bike-blurb">{s.blurb}</p>}
        <ul class="bike-films">
          {s.films.map((f) => (
            <li>
              <p class="bike-film__head">
                <span class="bike-film__title">{f.title}</span>
                <span class="bike-film__year">{f.year}</span>
              </p>
              <p class="bike-film__what">{f.what}</p>
              {f.links && f.links.length > 0 && (
                <p class="bike-film__where">
                  {f.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">{l.label} &rarr;</a>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="bike-section bike-section--wide" id="culture" aria-labelledby="culture-h">
    <h2 id="culture-h">Bicycle culture</h2>
    <ul class="bike-list bike-cols">
      {culture.map((r) => (
        <li>
          <span class="bike-list__name">
            {r.href ? <a href={r.href} target="_blank" rel="noopener">{r.name}</a> : r.name}
          </span>
          {r.note && <span class="bike-list__note">{r.note}</span>}
          {r.links && (
            <span class="bike-list__links">
              {r.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label} &rarr;</a>
              ))}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="bike-section bike-section--wide" id="creators" aria-labelledby="creators-h">
    <h2 id="creators-h">Creators and channels</h2>
    <div class="bike-groups">
      {creatorGroups.map((g) => (
        <div class="bike-subsection">
          <h3>{g.heading}</h3>
          <ul class="bike-list">
            {g.items.map((i) => (
              <li>
                <span class="bike-list__name">
                  {i.href ? <a href={i.href} target="_blank" rel="noopener">{i.name}</a> : i.name}
                </span>
                {i.note && <span class="bike-list__note">{i.note}</span>}
                {i.links && (
                  <span class="bike-list__links">
                    {i.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener">{l.label} &rarr;</a>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bike-section bike-section--wide" id="books" aria-labelledby="books-h">
    <h2 id="books-h">Books</h2>
    <ul class="bike-books bike-cols">
      {books.map((b) => (
        <li>
          <p class="bike-film__head">
            <span class="bike-film__title">
              {b.href ? <a href={b.href} target="_blank" rel="noopener">{b.title}</a> : b.title}
            </span>
            <span class="bike-film__year">{b.author}, {b.year}</span>
          </p>
          <p class="bike-film__what">{b.why}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bike-section bike-section--wide" id="websites" aria-labelledby="websites-h">
    <h2 id="websites-h">Websites and forums</h2>
    <div class="bike-groups">
      {siteGroups.map((g) => (
        <div class="bike-subsection">
          <h3>{g.heading}</h3>
          <ul class="bike-list">
            {g.items.map((i) => (
              <li>
                <span class="bike-list__name">
                  {i.href ? <a href={i.href} target="_blank" rel="noopener">{i.name}</a> : i.name}
                </span>
                {i.note && <span class="bike-list__note">{i.note}</span>}
                {i.links && (
                  <span class="bike-list__links">
                    {i.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener">{l.label} &rarr;</a>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bike-section bike-section--wide" id="quotes" aria-labelledby="quotes-h">
    <h2 id="quotes-h">Quotes</h2>
    <div class="bike-quotes bike-cols">
      {quotes.map((q) => (
        <blockquote class="bike-quote">
          <p>{q.text}</p>
          <cite>{q.source}</cite>
        </blockquote>
      ))}
    </div>
    <p class="bike-footnote">
      {quoteFootnote.text}{" "}
      <a href={quoteFootnote.href} target="_blank" rel="noopener">Quote Investigator &rarr;</a>
    </p>
  </section>

  <p class="bike-top"><a href="#top">Back to top</a></p>
</BaseLayout>

<script>
  // Jump-nav highlighting. Two paths so it degrades well:
  //  1. a click sets the active tab immediately (works everywhere)
  //  2. an IntersectionObserver keeps it in sync during free scrolling
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".bike-toc a")];
  const byId = new Map(links.map((a) => [a.dataset.toc, a]));
  const sections = [...document.querySelectorAll(".bike-section[id]")];

  const setActive = (id?: string | null) => {
    if (!id || !byId.has(id)) return;
    links.forEach((a) => a.classList.remove("is-active"));
    byId.get(id)!.classList.add("is-active");
  };

  links.forEach((a) => a.addEventListener("click", () => setActive(a.dataset.toc)));

  if (sections.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        const top = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (top) setActive(top.target.id);
      },
      { rootMargin: "-15% 0px -70% 0px", threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
  }

  // Deep link straight to a section.
  if (location.hash) setActive(location.hash.slice(1));
</script>

<style>
  .bike-intro {
    max-width: var(--measure);
  }

  /* Only the opening line is set as a lede; the rest reads as body prose. */
  .bike-intro__p {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .bike-intro__p:last-of-type {
    margin-bottom: 0;
  }

  /* Jump nav: sticks to the top so any section is one click away. */
  .bike-toc {
    position: sticky;
    top: 0;
    z-index: 10;
    margin-top: 2rem;
    padding: 0.625rem 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .bike-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bike-toc a {
    display: inline-block;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink-soft);
    padding: 0.125rem 0;
    border-bottom: 1px solid transparent;
  }

  .bike-toc a:hover { color: var(--color-ink); }

  .bike-toc a.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .bike-section {
    max-width: var(--measure);
    margin-top: 3rem;
    /* keep a jumped-to heading clear of the sticky bar */
    scroll-margin-top: 4.5rem;
  }

  .bike-section > h2 {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .bike-subsection { margin-top: 2rem; }

  .bike-subsection h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
  }

  .bike-blurb {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  .bike-films,
  .bike-books {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bike-films li,
  .bike-books li {
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .bike-films li:last-child { border-bottom: none; }

  .bike-film__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 0 0 0.25rem;
  }

  .bike-film__title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
  }

  .bike-film__year {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .bike-film__what {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .bike-film__where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }

  .bike-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bike-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .bike-list li:last-child { border-bottom: none; }

  .bike-list__name { font-weight: 500; }

  .bike-list__note {
    color: var(--color-ink-soft);
    display: block;
  }

  .bike-list__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
  }

  .bike-quote {
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-border);
    break-inside: avoid;
  }

  .bike-quote p {
    margin: 0 0 0.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .bike-quote cite {
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }

  .bike-footnote {
    max-width: var(--measure);
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .bike-top {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  /* On a wide screen the list sections pair up, which roughly halves their
     height. Films stay one column because they are prose. */
  @media (min-width: 56rem) {
    .bike-section--wide { max-width: none; }

    .bike-cols,
    .bike-groups {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 3rem;
      align-items: start;
    }

    .bike-books li,
    .bike-groups .bike-subsection {
      break-inside: avoid;
    }

    .bike-groups .bike-subsection:nth-child(-n + 2) {
      margin-top: 1.5rem;
    }
  }
</style>
