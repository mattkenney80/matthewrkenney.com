---
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, type Article } from "../../lib/articles";

const { DB } = env;
const { results } = await DB.prepare(
  "SELECT * FROM articles ORDER BY date DESC"
).all<Article>();
const articles = results ?? [];
---

<BaseLayout title="Admin · Writing" robots="noindex, nofollow">
  <div class="admin-bar">
    <h1>Articles</h1>
    <div class="admin-bar__actions">
      <a class="btn" href="/admin/settings">Site settings</a>
      <a class="btn btn--primary" href="/admin/new">New article</a>
      <form method="POST" action="/admin/logout" style="display:inline;">
        <button class="btn" type="submit">Log out</button>
      </form>
    </div>
  </div>

  {articles.length === 0 ? (
    <p class="lede">No articles yet.</p>
  ) : (
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Date</th>
          <th class="admin-table__actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        {articles.map((article) => (
          <tr>
            <td>
              <a href={`/admin/edit/${article.id}`}>{article.title}</a>
            </td>
            <td>
              {article.published ? (
                <span class="status-pill status-pill--published">Visible</span>
              ) : (
                <span class="status-pill status-pill--draft">Hidden</span>
              )}
            </td>
            <td>{formatDate(article.date)}</td>
            <td>
              <div class="row-actions">
                <form method="POST" action={`/admin/toggle/${article.id}`}>
                  <button
                    class={`btn ${article.published ? "" : "btn--primary"}`}
                    type="submit"
                    title={article.published ? "Hide from the site (returns 404)" : "Publish to the site"}
                  >
                    {article.published ? "Hide" : "Show"}
                  </button>
                </form>
                <a class="btn" href={`/admin/edit/${article.id}`}>Edit</a>
                <form method="POST" action={`/admin/delete/${article.id}`} onsubmit="return confirm('Delete this article? This cannot be undone.')">
                  <button class="btn btn--danger" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</BaseLayout>

<style>
  .admin-bar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .row-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: flex-end;
  }
  .row-actions form {
    margin: 0;
  }
  .admin-table__actions {
    text-align: right;
  }
</style>
