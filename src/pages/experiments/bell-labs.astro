---
// Out of Bell Labs: five ideas from one New Jersey lab, each on its own row ("threads" layout).
// Rendered from src/data/bell-labs/bell-labs.json; the map, chart and card are drawn by
// src/scripts/threads.js, ported from Matthew's bell-labs.html prototype.
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../lib/settings";
import idea from "../../data/bell-labs/bell-labs.json";
import "../../styles/threads.css";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

const src = (n: number) => idea.sources.find((s) => s.n === n);
const findings = [
  { k: "Invented here, scaled there", text: "Texas Instruments sold the transistor radio, Hoffman sold the solar cell, Motorola made the first handheld cell call and Apple put Unix in the Mac. Bell Labs was the birthplace, almost never the factory." },
  { k: "Washington was a co-author", text: "The 1956 consent decree made 7,820 Bell patents free to use and kept AT&T out of computers. That is part of why the transistor went west and Unix went to Berkeley." },
  { k: "The ideas crossed", text: "Fuller and Pearson found the solar cell while working on silicon transistors. In 1962 Telstar flew 3,600 solar cells and 1,000 transistors, two Bell inventions in one satellite." },
];
const isDraft = /draft/i.test(idea.intro.status);
---

<BaseLayout title="Out of Bell Labs" description={idea.question} wide>
  <p class="bl-eyebrow">Experiment &middot; New Jersey innovation</p>
  <h1>Five ideas that left <em>Bell Labs</em></h1>
  <p class="lede">
    On January 1, 1925, AT&amp;T put its engineers into one company you could not buy stock in. Over
    the next half century they produced the transistor, the bit, the solar cell, Unix and the cellular
    network. Then other people, in other places, turned each one into the modern world. Drag through
    the years and follow all five out of New Jersey.
  </p>
  <p class="lede">
    Bell Labs ran on two kinds of energy. Mervin Kelly&rsquo;s was proximity: hallways so long you
    could not walk to lunch without bumping into someone smarter than you in a different field.
    William Shockley&rsquo;s was spite. Left off the transistor patent, he locked himself in a Chicago
    hotel room and invented a better one. Then he moved to California and managed so badly that his
    eight best engineers quit and founded Silicon Valley without him.
  </p>

  <aside class="bl-note" aria-label={idea.intro.label}>
    <p class="bl-mono">
      <span>{idea.intro.label}</span><span>{idea.intro.author}</span>{isDraft && <span class="bl-draft">Draft</span>}
    </p>
    {idea.intro.paragraphs.map((p) => <p>{p}</p>)}
    <p class="bl-mono bl-srcline">
      Sources {idea.intro.sources.map((n, i) => <>{i > 0 && ", "}<a href={`#bl-src-${n}`} title={src(n)?.title}>{n}</a></>)}
    </p>
  </aside>

  <div class="bl" id="bl">
    <section class="bl-stage" aria-label="Idea map">
      <div class="bl-chips" id="bl-chips" role="group" aria-label="Choose an idea to follow"></div>
      <div class="bl-stage-head">
        <span class="bl-mono">Drag the map, or use the arrow keys</span>
        <div class="bl-ctrls">
          <button id="bl-prev" type="button">&larr; Back</button>
          <button id="bl-next" type="button">Next &rarr;</button>
        </div>
      </div>
      <svg id="bl-map" tabindex="0" role="slider" aria-label="Year" aria-valuemin="1925" aria-valuemax="2028"></svg>
      <p class="bl-hint">
        Each row is one idea. The blue token is the idea you are following; Back and Next step through
        its stations, and Up and Down switch ideas. Dashed lines show where one idea fed another.
      </p>
    </section>

    <article class="bl-card" id="bl-card" aria-live="polite"></article>

    <section class="bl-chart" aria-labelledby="bl-chart-h">
      <h2 id="bl-chart-h">The economy they grew into</h2>
      <p class="bl-readout" id="bl-readout"></p>
      <svg id="bl-chartsvg" aria-hidden="true"></svg>
      <p class="bl-hint">
        {idea.series.label}, {idea.series.unit}. {idea.series.note} Small dots on the baseline mark the
        stations of the idea you are following.
        (<a href={`#bl-src-${idea.series.source}`}>source {idea.series.source}</a>)
      </p>
    </section>
  </div>

  <section class="bl-findings" aria-label="What the map shows">
    {findings.map((f) => <p><span>{f.k}</span>{f.text}</p>)}
  </section>

  <section class="bl-sec" aria-labelledby="bl-other">
    <h2 id="bl-other">The other side</h2>
    <ul class="bl-counter">
      {idea.counterpoints.map((c) => (
        <li>{c.claim}<span class="bl-who">{c.who} &middot; {c.status}</span></li>
      ))}
    </ul>
  </section>

  <section class="bl-sec" aria-labelledby="bl-sources">
    <h2 id="bl-sources">Sources</h2>
    <ol class="bl-sources">
      {idea.sources.map((s) => (
        <li id={`bl-src-${s.n}`} value={s.n}><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>
      ))}
    </ol>
  </section>

  <p class="bl-back"><a href="/experiments">&larr; All experiments</a></p>

  <script type="application/json" id="bl-data" set:html={JSON.stringify(idea)}></script>
</BaseLayout>

<script>
  import "../../scripts/threads.js";
</script>

<style is:global>
  .lede + .lede { margin-top: var(--space-2); }
  h1 em { font-style: normal; color: #2340c8; }
  .bl, .bl-note { --accent: #2340c8; --accent-soft: rgba(35, 64, 200, 0.2);
    --t-lab: #3d4a47; --t-transistor: #7a4fb0; --t-info: #1f7a5a; --t-solar: #a3601b; --t-unix: #9b2f3f; --t-cell: #12707a; }
</style>
