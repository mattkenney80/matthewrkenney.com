---
// Research notes for the third idea. Replaced by the interactive page once the
// spending series is complete and src/data/ideas/campaign-finance.json exists.
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../../lib/settings";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

type Item = { year: string; who: string; text: string; src: [string, string][] };

const reform: Item[] = [
  { year: "1907", who: "Congress, the Tillman Act", text: "Bans corporate contributions to federal campaigns.", src: [["MTSU", "https://firstamendment.mtsu.edu/article/federal-election-campaign-act-of-1971"]] },
  { year: "1947", who: "Congress, over President Truman's veto", text: "Taft-Hartley bans union contributions and restricts corporate and union election spending.", src: [["New World Encyclopedia", "https://www.newworldencyclopedia.org/entry/Taft-Hartley_Act"]] },
  { year: "1971", who: "Congress, the Federal Election Campaign Act", text: "Caps how much campaigns spend on advertising and expands disclosure.", src: [["MTSU", "https://firstamendment.mtsu.edu/article/federal-election-campaign-act-of-1971"]] },
  { year: "1974", who: "Congress after Watergate; President Gerald Ford", text: "Caps individual gifts at $1,000 per election and committee gifts at $5,000, limits spending, and creates the Federal Election Commission.", src: [["FECA Amendments of 1974", "https://en.wikipedia.org/wiki/Federal_Election_Campaign_Act_Amendments_of_1974"]] },
];

const speech: Item[] = [
  { year: "1971", who: "Ralph K. Winter Jr., Yale Law School, for the American Enterprise Institute", text: "“Money, Politics and the First Amendment,” in an AEI volume arguing the constitutional case against limits.", src: [["Catalog record", "https://search.law.villanova.edu/Record/167089"]] },
  { year: "1973", who: "Ralph K. Winter Jr. with John R. Bolton, American Enterprise Institute", text: "Campaign Financing and Political Freedom, written against the limits Congress was passing. Bolton later called Winter the intellectual father of the arguments the Court accepted in Buckley.", src: [["Catalog record", "https://lawcat.berkeley.edu/record/1303214"], ["Econlib", "https://www.econlib.org/ralph-k-winter-jr-rip/"], ["Election Law Blog", "https://electionlawblog.org/?p=79389"]] },
  { year: "1975", who: "Sen. James Buckley, Eugene McCarthy, Stewart Mott, the New York Civil Liberties Union and others", text: "A left-right coalition, from the American Conservative Union to the Socialist Workers Party, sues to strike down the 1974 law. Winter argues it.", src: [["Buckley v. Valeo", "https://en.wikipedia.org/wiki/Buckley_v._Valeo"], ["Winter's account", "https://openyls.law.yale.edu/entities/publication/b002747a-ea76-4efd-a056-5ad92ffc2f3f"]] },
  { year: "1976", who: "The Supreme Court, Buckley v. Valeo", text: "Spending money on elections is protected speech. Spending limits fall; limits on contributions to candidates and disclosure survive.", src: [["Britannica", "https://www.britannica.com/event/Buckley-v-Valeo"]] },
  { year: "1978", who: "Justice Lewis Powell, First National Bank of Boston v. Bellotti", text: "Corporations may spend on ballot questions. Seven years earlier Powell had written a memo urging the U.S. Chamber of Commerce to organize business politically and in the courts.", src: [["Bellotti", "https://en.wikipedia.org/wiki/First_National_Bank_of_Boston_v._Bellotti"], ["Washington Monthly", "https://washingtonmonthly.com/2016/01/24/bucking-the-trends/"]] },
];

const takeoff: Item[] = [
  { year: "1991", who: "Chip Mellor and Clint Bolick, Institute for Justice; Charles Koch", text: "A libertarian public interest law firm, started with Koch seed money. It later wins the case that creates super PACs.", src: [["Philanthropy Roundtable", "https://www.philanthropyroundtable.org/almanac/institute-for-justice/"]] },
  { year: "2001 to 2005", who: "Bradley Smith", text: "His book Unfree Speech argues limits do more harm than good. He chairs the Federal Election Commission, then founds the Center for Competitive Politics (now the Institute for Free Speech).", src: [["Publishers Weekly", "https://publishersweekly.com/978-0-691-07045-2"], ["Institute for Free Speech", "https://www.ifs.org/wp-content/uploads/2018/03/2018-03-26_Issue-Brief_Wachob_SpeechNow.org-v-FEC-Protecting-The-First-Amendment-Rights-of-Americans.pdf"]] },
  { year: "2008", who: "David Bossie, Citizens United; lawyers James Bopp Jr. and Ted Olson", text: "Hillary: The Movie is blocked as campaign advertising under the McCain-Feingold law. The group sues.", src: [["Reason", "https://reason.com/2008/01/14/hillary-the-movie-the-lawsuit/"], ["CS Monitor", "https://www.csmonitor.com/2008/0201/p03s01-ussc.html"]] },
  { year: "Jan 2010", who: "Justice Anthony Kennedy, Citizens United v. FEC (5 to 4)", text: "Corporations and unions may spend without limit on independent political ads. Cato and the Institute for Justice back Citizens United; Senators McCain and Feingold back the FEC.", src: [["Cato brief", "https://www.cato.org/legal-briefs/citizens-united-v-federal-election-commission"], ["McCain-Feingold brief", "https://campaignlegal.org/document/citizens-united-v-fec-brief-filed-senators-mccain-feingold-et-al"]] },
  { year: "Mar 2010", who: "David Keating, SpeechNow.org; the Institute for Justice and Bradley Smith's center", text: "A federal appeals court rules 9 to 0 that groups spending independently can raise unlimited money. The super PAC is born.", src: [["Institute for Justice", "https://ij.org/press-release/speechnoworg-can-speak-now-federal-court-declares-contribution-limits-unconstitutional-and-enjoins-federal-election-commission/"]] },
  { year: "2010", who: "Karl Rove and Ed Gillespie", text: "American Crossroads, a super PAC, and Crossroads GPS, a nonprofit that mostly keeps its donors secret. Together they raise $123 million by the end of 2011.", src: [["Center for Public Integrity", "https://publicintegrity.org/politics/crossroads-political-machine-funded-mostly-by-secret-donors/"]] },
];

const accel: Item[] = [
  { year: "2014", who: "Shaun McCutcheon and the RNC; Chief Justice John Roberts", text: "McCutcheon v. FEC (5 to 4) removes the cap on how much one donor can give in total across candidates and parties.", src: [["Public Citizen", "https://clpblog.citizen.org/supreme-court-strikes-down-aggregate-campaign-limits-under-first-amendment/"]] },
  { year: "2020 to 2024", who: "The cost of federal elections", text: "About $15.1 billion in 2020 and $8.9 billion in the 2022 midterms. OpenSecrets projected at least $15.9 billion for 2024, with outside groups on track to pass $5 billion.", src: [["CNN via KRDO", "https://krdo.com/news/2024/10/08/spending-in-presidential-and-congressional-races-projected-to-hit-nearly-16-billion-and-smash-records-new-analysis-shows/"], ["OpenSecrets via ZNetwork", "https://znetwork.org/znetarticle/cost-of-2022-federal-elections-tops-8-9-billion-a-new-midterm-record"]] },
];

const FEC = "https://api.open.fec.gov/developers/";
const sections = [
  { id: "cf-reform", title: "The first idea: limit money in politics", items: reform },
  { id: "cf-speech", title: "The counter-idea: money is speech", items: speech },
  { id: "cf-take", title: "When it took off", items: takeoff },
  { id: "cf-accel", title: "When it accelerated", items: accel },
];
---

<BaseLayout title="Campaign Finance Superpacs" description="Where the idea that money is speech came from, and how it became the super PAC. Research notes.">
  <p class="pn-eyebrow"><a href="/experiments/who-sold-us-this-idea">Who Sold Us This Idea?</a> &middot; In research</p>
  <h1>Campaign Finance Superpacs</h1>
  <p class="lede">
    Two ideas collide here. Congress spent most of the twentieth century limiting money in politics.
    In 1971 a Yale law professor writing for a Washington think tank argued that spending money is
    speech, and the courts agreed, one step at a time, until 2010 gave us the super PAC. These are
    research notes; the interactive timeline comes once the spending data is complete.
  </p>

  {sections.map((sec) => (
    <section class="pn-sec" aria-labelledby={sec.id}>
      <h2 id={sec.id}>{sec.title}</h2>
      <ol class="pn-list">
        {sec.items.map((it) => (
          <li>
            <span class="pn-year">{it.year}</span>
            <div>
              <b>{it.who}</b>
              <p>
                {it.text}{" "}
                <span class="pn-src">
                  {it.src.map(([label, url], i) => <>{i > 0 && ", "}<a href={url} target="_blank" rel="noopener">{label}</a></>)}
                </span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="pn-sec" aria-labelledby="cf-2024">
    <h2 id="cf-2024">Where it landed: Harris vs. Trump, 2024</h2>
    <div class="pn-table">
      <table>
        <thead><tr><th>Campaign committee</th><th>Raised</th><th>Spent</th></tr></thead>
        <tbody>
          <tr><td>Harris for President</td><td>$1.175 billion</td><td>$1.175 billion</td></tr>
          <tr><td>Donald J. Trump for President 2024</td><td>$496 million</td><td>$472 million</td></tr>
        </tbody>
      </table>
    </div>
    <p class="pn-note">
      Official totals for each candidate's main committee, 2023 to 2024, from the
      <a href={FEC}>Federal Election Commission</a>. Harris took over Biden's committee in July 2024,
      so her figure includes his months. Larger figures in the news add the party and joint fundraising
      committees. Outside money narrowed the gap: by October the pro-Trump super PAC MAGA Inc. had
      spent over $239 million and pro-Harris Future Forward over $212 million
      (<a href="https://krdo.com/news/2024/10/08/spending-in-presidential-and-congressional-races-projected-to-hit-nearly-16-billion-and-smash-records-new-analysis-shows/">OpenSecrets via CNN</a>),
      and Trump left much of his field work to outside groups, including Elon Musk's super PAC
      (<a href="https://www.nbcnews.com/politics/2024-election/kamala-harris-campaign-spent-277-million-final-weeks-rcna182923">NBC News</a>).
    </p>
  </section>

  <section class="pn-sec" aria-labelledby="cf-d">
    <h2 id="cf-d">The case for the defense</h2>
    <ul class="pn-def">
      <li>Political speech is the core of the First Amendment, and money is how speech reaches people. Citizens United began with a documentary about a candidate that the government barred from being shown.</li>
      <li>Super PACs have to disclose their donors. The secret money runs through nonprofits like Crossroads GPS, which is a disclosure problem, not a super PAC problem.</li>
      <li>Money does not simply buy elections. In 2024 Harris's campaign outspent Trump's by about two and a half to one, and lost.</li>
    </ul>
  </section>

  <p class="pn-back"><a href="/experiments/who-sold-us-this-idea">&larr; All ideas</a></p>
</BaseLayout>

<style>
  .pn-eyebrow { margin: 0 0 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-soft); }
  .pn-eyebrow a { color: inherit; }
  .pn-sec { margin-top: var(--space-4); max-width: 46rem; }
  .pn-sec h2 { font-size: 1.25rem; }
  .pn-table { overflow-x: auto; }
  .pn-table table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  .pn-table th, .pn-table td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--color-border); }
  .pn-table th { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-soft); font-weight: 400; }
  .pn-note { font-size: 0.9rem; color: var(--color-ink-soft); }
  .pn-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .pn-list li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-2); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  @media (max-width: 30rem) { .pn-list li { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; } }
  .pn-year { font-family: var(--font-serif); color: #2340c8; font-variant-numeric: tabular-nums; }
  .pn-list p { margin: 0.2rem 0 0; }
  .pn-src { font-size: 0.85rem; color: var(--color-ink-soft); }
  .pn-src a { color: inherit; }
  .pn-def li { margin-bottom: 0.6rem; }
  .pn-back { margin-top: var(--space-4); }
</style>
