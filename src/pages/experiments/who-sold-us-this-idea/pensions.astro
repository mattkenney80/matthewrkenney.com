---
// Research notes for the second idea. Replaced by the interactive page once the
// stations are verified and src/data/ideas/pensions.json exists.
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../../lib/settings";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

const DOL = "https://www.dol.gov/sites/dolgov/files/ebsa/pdf_files/private-pension-plan-bulletin-historical-tables-and-graphs.pdf";

const numbers = [
  { year: 1975, db: "27.2 million", dc: "11.2 million", share: "71%" },
  { year: 1980, db: "30.1 million (peak)", dc: "18.9 million", share: "61%" },
  { year: 1984, db: "30.1 million", dc: "30.5 million", share: "50%, the crossover" },
  { year: 2000, db: "22.2 million", dc: "50.9 million", share: "30%" },
  { year: 2022, db: "11.3 million", dc: "92.6 million", share: "11%" },
];

const rise = [
  { year: "1875", who: "American Express", text: "Creates the first private pension plan in the United States.", src: [["ThinkAdvisor", "https://thinkadvisor.com/2016/09/06/9-milestones-in-the-rise-and-fall-of-american-pensions"]] },
  { year: "1948 to 1949", who: "Inland Steel and the NLRB", text: "The courts uphold the labor board: pensions are something unions can bargain over.", src: [["Inland Steel v. NLRB", "https://www.casemine.com/commentary/us/inland-steel-co.-v.-nlrb:-constitutional-implications-of-collective-bargaining-over-pension-plans/view"]] },
  { year: "1950", who: "Walter Reuther, United Auto Workers", text: "The “Treaty of Detroit” with General Motors trades labor peace for pensions and health care. Ford and Chrysler follow.", src: [["Treaty of Detroit", "https://en.wikipedia.org/wiki/Reuther%27s_Treaty_of_Detroit"]] },
  { year: "1963", who: "Studebaker, South Bend", text: "The plant closes and its pension plan fails. More than 8,500 auto workers lose some or all of their benefits.", src: [["PBGC", "https://www.pbgc.gov/about/pbgc-pensions-studebaker"]] },
  { year: "1974", who: "Sen. Jacob Javits; President Gerald Ford", text: "ERISA becomes law and creates federal insurance for private pensions.", src: [["PBGC history", "https://www.pbgc.gov/about/who-we-are/history"]] },
];

const turn = [
  { year: "1978", who: "Congress; President Jimmy Carter", text: "The Revenue Act of 1978 adds Section 401(k), a narrow rule about deferred pay.", src: [["ICI", "https://idc.org/system/files/attachments/per12-02.pdf"]] },
  { year: "1980 to 1981", who: "Ted Benna, benefits consultant; the IRS", text: "Benna reads the rule as a way for any worker to save from their own paycheck, with an employer match. IRS rules in November 1981 make it official.", src: [["Gusto", "https://gusto.com/resources/articles/benefits/401k-history"], ["ICI", "https://idc.org/system/files/attachments/per12-02.pdf"]] },
  { year: "1980s", who: "Corporate raiders and employers; Sen. Howard Metzenbaum", text: "More than $20 billion in surplus is taken back from terminated pensions. Congress starts taxing these reversions in 1986.", src: [["GAO", "https://www.gao.gov/assets/hrd-90-51br.pdf"], ["SOA", "https://production.soa.org/493886/globalassets/assets/files/research/projects/reversion.pdf"]] },
  { year: "1980s", who: "Kwasha Lipton, consultants; Bank of America", text: "The cash balance plan: a pension designed to look like an account, sold to dozens of employers.", src: [["Kwasha Lipton", "https://en.wikipedia.org/wiki/Kwasha_Lipton"]] },
  { year: "1999 to 2004", who: "IBM; Kathi Cooper and 140,000 employees", text: "IBM's switch to cash balance is challenged as age discrimination. IBM settles and takes a $320 million charge.", src: [["Workforce", "https://www.workforce.com/news/the-cash-balance-battle-grinds-on"]] },
  { year: "2004 to 2011", who: "Fortune 1000 boardrooms", text: "Companies with at least one frozen pension grow from 45 to 237.", src: [["Business Insurance", "https://www.businessinsurance.com/fortune-1000-pension-freezes-accelerate/"]] },
  { year: "2006", who: "Congress; Richard Thaler and Shlomo Benartzi", text: "The Pension Protection Act makes automatic 401(k) enrollment the norm, building on their research.", src: [["Brookings", "https://www.brookings.edu/wp-content/uploads/2016/06/04_pension_protection.pdf"]] },
  { year: "2017", who: "Ted Benna", text: "Tells the Wall Street Journal he regrets it: the 401(k) was never meant to be the main retirement plan.", src: [["CS Monitor", "https://csmonitor.com/Business/2017/0104/Why-Father-of-the-401-k-says-he-regrets-pushing-the-retirement-plan"]] },
];

const parallel = [
  { year: "1980", who: "Peter Ferrara, Cato Institute", text: "Cato's first book argues for replacing Social Security with private accounts.", src: [["Harvard Law Today", "https://hls.harvard.edu/today/26-years-later"]] },
  { year: "1984", who: "Stuart Butler and Peter Germanis, Heritage Foundation", text: "“Achieving a ‘Leninist’ Strategy” lays out a long campaign for private accounts.", src: [["Cato", "https://clips.cato.org/sites/default/files/Cato-Salon-SocialSecurity_1.pdf"]] },
  { year: "2005", who: "President George W. Bush", text: "The “ownership society” puts personal accounts at the center of Social Security reform. It stalls.", src: [["Brookings", "https://www.brookings.edu/articles/why-the-2005-social-security-initiative-failed-and-what-it-means-for-the-future/"]] },
];
---

<BaseLayout title="Who sold us the 401(k)?" description="Research notes on the decline of the American pension and the rise of the 401(k).">
  <p class="pn-eyebrow"><a href="/experiments/who-sold-us-this-idea">Who Sold Us This Idea?</a> &middot; In research</p>
  <h1>Who sold us the 401(k)?</h1>
  <p class="lede">
    In 1975 seven in ten workers in a workplace retirement plan were earning a pension. By 2022 it
    was about one in ten. These are research notes; the interactive timeline comes once every
    station is sourced.
  </p>

  <section class="pn-sec" aria-labelledby="pn-n">
    <h2 id="pn-n">The numbers</h2>
    <div class="pn-table">
      <table>
        <thead><tr><th>Year</th><th>Earning a pension</th><th>In a 401(k)-type plan</th><th>Pension share</th></tr></thead>
        <tbody>
          {numbers.map((r) => <tr><td>{r.year}</td><td>{r.db}</td><td>{r.dc}</td><td>{r.share}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="pn-note">
      Active participants in private plans, from <a href={DOL}>Department of Labor Form 5500 data, 1975 to 2022</a>.
      The department revised how it counts participants in 2004, so later years are not a perfect
      match for earlier ones. Pensions were never universal: at their 1979 peak about half of private
      workers had a plan of any kind (<a href="https://crr.bc.edu/an-update-on-private-pensions/ib_50_508">Boston College CRR</a>).
    </p>
  </section>

  {[
    { id: "pn-rise", title: "The promise", items: rise },
    { id: "pn-turn", title: "The turn to the account", items: turn },
    { id: "pn-par", title: "The parallel push, on Social Security", items: parallel, note: "These think tanks and politicians campaigned for individual accounts in place of the public pension. The sources do not tie them to the decline of company pensions, so they run alongside the story rather than through it." },
  ].map((sec) => (
    <section class="pn-sec" aria-labelledby={sec.id}>
      <h2 id={sec.id}>{sec.title}</h2>
      {sec.note && <p class="pn-note">{sec.note}</p>}
      <ol class="pn-list">
        {sec.items.map((it) => (
          <li>
            <span class="pn-year">{it.year}</span>
            <div>
              <b>{it.who}</b>
              <p>
                {it.text}{" "}
                <span class="pn-src">
                  {it.src.map(([label, url], i) => <>{i > 0 && ", "}<a href={url} target="_blank" rel="noopener">{label}</a></>)}
                </span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="pn-sec" aria-labelledby="pn-d">
    <h2 id="pn-d">The case for the defense</h2>
    <ul class="pn-def">
      <li>A 401(k) moves with you. Workers who change jobs get noticeably smaller pensions, even under identical plans (<a href="https://crr.bc.edu/wp-content/uploads/2006/10/wp_2006-18-508.pdf">Boston College CRR</a>).</li>
      <li>A pension is only as good as the company behind it. Studebaker is why federal pension insurance exists (<a href="https://www.pbgc.gov/about/pbgc-pensions-studebaker">PBGC</a>).</li>
      <li>The counterpoint: a 401(k) moves the investment risk, and the risk of outliving your money, from the employer to you.</li>
    </ul>
  </section>

  <p class="pn-back"><a href="/experiments/who-sold-us-this-idea">&larr; All ideas</a></p>
</BaseLayout>

<style>
  .pn-eyebrow { margin: 0 0 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-soft); }
  .pn-eyebrow a { color: inherit; }
  .pn-sec { margin-top: var(--space-4); max-width: 46rem; }
  .pn-sec h2 { font-size: 1.25rem; }
  .pn-table { overflow-x: auto; }
  .pn-table table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  .pn-table th, .pn-table td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--color-border); }
  .pn-table th { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-soft); font-weight: 400; }
  .pn-note { font-size: 0.9rem; color: var(--color-ink-soft); }
  .pn-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .pn-list li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-2); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  @media (max-width: 30rem) { .pn-list li { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; } }
  .pn-year { font-family: var(--font-serif); color: #2340c8; font-variant-numeric: tabular-nums; }
  .pn-list p { margin: 0.2rem 0 0; }
  .pn-src { font-size: 0.85rem; color: var(--color-ink-soft); }
  .pn-src a { color: inherit; }
  .pn-def li { margin-bottom: 0.6rem; }
  .pn-back { margin-top: var(--space-4); }
</style>
