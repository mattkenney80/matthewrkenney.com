---
// The Long Manifesto: following the ideas of Marxism, one country per row ("threads" layout).
// Rendered from src/data/marxism/marxism.json; the map, chart and card are drawn by
// src/scripts/threads.js, the same engine as Out of Bell Labs.
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../../lib/settings";
import idea from "../../../data/marxism/marxism.json";
import "../../../styles/threads.css";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

// Counterpoints still marked NEEDS SOURCE or NEEDS VERIFICATION stay off the page.
const counterpoints = idea.counterpoints.filter((c) => !/NEEDS (SOURCE|VERIFICATION)/i.test(c.status));
---

<BaseLayout title="The Long Manifesto" description={idea.question} wide>
  <p class="bl-eyebrow"><a href="/experiments/who-sold-us-this-idea">Who Sold Us This Idea?</a> &middot; Following the ideas of Marxism</p>
  <h1>The Long <em>Manifesto</em></h1>
  {idea.intro.paragraphs.map((p) => <p class="lede">{p}</p>)}

  <aside class="bl-note" aria-label="The question">
    <p class="bl-mono"><span>The question</span></p>
    <p>
      {idea.question} Seven rows follow the pamphlet out of London: the book itself, the reformers
      who dropped revolution, and the parties that took power in Russia, China, Vietnam, Cambodia and
      Cuba. Drag through the years and pick a row to follow.
    </p>
  </aside>

  <div class="bl" id="bl">
    <section class="bl-stage" aria-label="Idea map">
      <div class="bl-chips" id="bl-chips" role="group" aria-label="Choose a row to follow"></div>
      <div class="bl-stage-head">
        <span class="bl-mono">Drag the map, or use the arrow keys</span>
        <div class="bl-ctrls">
          <button id="bl-prev" type="button">&larr; Back</button>
          <button id="bl-next" type="button">Next &rarr;</button>
        </div>
      </div>
      <svg id="bl-map" tabindex="0" role="slider" aria-label="Year" aria-valuemin="1845" aria-valuemax="2025"></svg>
      <p class="bl-hint">
        Each row is one path the idea took. The blue token is the row you are following; Back and Next
        step through its stations, and Up and Down switch rows. Dashed lines show where one row fed
        another.
      </p>
    </section>

    <article class="bl-card" id="bl-card" aria-live="polite"></article>

    <section class="bl-chart" aria-labelledby="bl-chart-h">
      <h2 id="bl-chart-h">{idea.series.label}</h2>
      <p class="bl-readout" id="bl-readout"></p>
      <svg id="bl-chartsvg" aria-hidden="true"></svg>
      <p class="bl-hint">
        {idea.series.note} Small dots on the baseline mark the stations of the row you are following.
        (<a href={`#bl-src-${idea.series.source}`}>source {idea.series.source}</a>)
      </p>
    </section>
  </div>

  <section class="bl-findings" aria-label="What the map shows">
    {idea.findings.map((f) => <p><span>{f.label}</span>{f.text}</p>)}
  </section>

  <section class="bl-sec" aria-labelledby="bl-other">
    <h2 id="bl-other">The other side</h2>
    <ul class="bl-counter">
      {counterpoints.map((c) => (
        <li>{c.claim}<span class="bl-who">{c.who} &middot; {c.status}</span></li>
      ))}
    </ul>
  </section>

  <section class="bl-sec" aria-labelledby="bl-sources">
    <h2 id="bl-sources">Sources</h2>
    <ol class="bl-sources">
      {idea.sources.map((s) => (
        <li id={`bl-src-${s.n}`} value={s.n}><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>
      ))}
    </ol>
  </section>

  <p class="bl-back"><a href="/experiments/who-sold-us-this-idea">&larr; All ideas</a></p>

  <script type="application/json" id="bl-data" set:html={JSON.stringify(idea)}></script>
</BaseLayout>

<script>
  import "../../../scripts/threads.js";
</script>

<style is:global>
  .lede + .lede { margin-top: var(--space-2); }
  .bl-eyebrow a { color: inherit; }
  h1 em { font-style: normal; color: #2340c8; }
  .bl, .bl-note { --accent: #2340c8; --accent-soft: rgba(35, 64, 200, 0.2);
    --t-book: #3f3a35; --t-reform: #2f7a4c; --t-russia: #a3262d; --t-china: #b0651a; --t-vietnam: #11727c; --t-cambodia: #7a3f86; --t-cuba: #6b7420; }
</style>
