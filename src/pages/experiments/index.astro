---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../lib/settings";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

const experiments: { title: string; description: string; href?: string }[] = [
  {
    title: "Turn the Crank",
    description: "Pedal a bicycle crank to scrub through 131 Bicycle Crimes photographs in the order they were taken. SVG flywheel physics in the browser, with a Python script behind the images.",
    href: "/experiments/crank",
  },
  {
    title: "Cycling on Strava",
    description: "Activity feed, stats, and riding patterns from Strava via OAuth2. Shows rides grouped by location with streak tracking and time-of-day analysis.",
    href: "/experiments/strava",
  },
  {
    title: "Film Repertory",
    description: "Who keeps working with whom. Directors, cinematographers and writers, and the company they keep, drawn from TMDB credits as a constellation, a career timeline and a heatmap.",
    href: "/experiments/film-repertory",
  },
  {
    title: "Who Sold Us This Idea?",
    description: "Following one idea at a time from where it was born to where it landed, through the consultants, professors, journals, regulators and boardrooms that sold it. First up: CEO pay.",
    href: "/experiments/who-sold-us-this-idea",
  },
];
---

<BaseLayout title="Experiments" description="One-off demos and creative dead ends.">
  <h1>Experiments</h1>
  <p class="lede">
    A freeform space for one-off layouts, interactions, and demos that don't belong in
    writing or photography. Nothing here is precious. Some of it may break.
  </p>

  {experiments.length === 0 ? (
    <p class="meta" style="margin-top: 2rem;">No experiments published yet.</p>
  ) : (
    <div class="card-grid" style="margin-top: 2rem;">
      {experiments.map((exp) => (
        <a class="card" href={exp.href ?? "#"} style="text-decoration: none; color: inherit;">
          <h2>{exp.title}</h2>
          <p>{exp.description}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
