---
// Turn the crank: scrub through the Bicycle Crimes photographs by pedaling.
//
// The drivetrain geometry is computed here, on the server, so the SVG paints
// before any JavaScript runs. The client script only rotates three groups,
// scrolls the chain, and swaps photographs. Image files and manifest.json are
// produced by scripts/build_crank_images.py (Python, build time only).
export const prerender = false;

import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isSectionVisible } from "../../lib/settings";

if (!(await isSectionVisible(env?.DB, "experiments"))) {
  return Astro.rewrite("/404");
}

import {
  ARM, CASSETTE, DEFAULT_GEAR, HUB, MOUNT, PULLEY_R, PULLEY_TEETH, RING, RING_R, RING_TEETH, TAU,
  cagePath, chainPath, circlePath, derailleurAt, f, linksPath, rOf, sprocketPath, teethPath,
} from "../../lib/drivetrain";

// Chainring: teeth with the middle cut away, so the spider shows through.
const ringD = teethPath(RING.x, RING.y, RING_TEETH, RING_R - 2.6, RING_R + 2.8) + " " + circlePath(RING.x, RING.y, RING_R - 12);
const spiderArms = [0, 1, 2, 3].map((i) => {
  const a = (i / 4) * TAU + Math.PI / 4;
  return { x: RING.x + (RING_R - 10) * Math.cos(a), y: RING.y + (RING_R - 10) * Math.sin(a) };
});
const armD =
  `M${RING.x} ${RING.y - 15} L${RING.x + ARM} ${RING.y - 9} ` +
  `A9 9 0 0 1 ${RING.x + ARM} ${RING.y + 9} L${RING.x} ${RING.y + 15} ` +
  `A15 15 0 0 1 ${RING.x} ${RING.y - 15} Z`;

// Cassette, biggest cog drawn first so the small ones sit on top.
const cogs = CASSETTE.map((teeth, i) => ({ i, teeth, d: sprocketPath(HUB.x, HUB.y, teeth) }));
const drawOrder = [...cogs].sort((a, b) => b.teeth - a.teeth);
const pulleyD = teethPath(0, 0, PULLEY_TEETH, PULLEY_R - 2.4, PULLEY_R + 2.4);

const rc0 = rOf(CASSETTE[DEFAULT_GEAR]);
const der0 = derailleurAt(rc0);
const chain0 = chainPath(rc0);
const ratio0 = RING_TEETH / CASSETTE[DEFAULT_GEAR];
---

<BaseLayout
  title="Turn the Crank"
  description="Turn a bicycle crank to scrub through 131 Bicycle Crimes photographs in the order they were taken."
  wide
>
  <p class="crank-eyebrow">Experiment &middot; SVG, JavaScript, and a little Python</p>
  <h1>Turn the crank</h1>
  <p class="lede">
    131 photographs from the <a href="/photography/bicycle-crimes">Bicycle Crimes</a> series, in the
    order I took them. Pedal forward through eight years. Pedal backward to rewind. Shift gears and
    watch what the bike does.
  </p>

  <section class="crank-app" id="crank-app" aria-label="Photograph viewer driven by a bicycle crank">
    <figure class="crank-figure">
      <div class="crank-frame" id="frame">
        <img id="frame-img" alt="" decoding="async" />
        <p class="crank-loading" id="loading">Loading photographs&hellip;</p>
      </div>
      <figcaption class="crank-caption">
        <span class="crank-caption__date" id="cap-date">&nbsp;</span>
        <span class="crank-caption__count" id="cap-count">&nbsp;</span>
      </figcaption>
    </figure>

    <div class="crank-rig">
      <div
        class="crank-drive"
        id="drive"
        role="slider"
        tabindex="0"
        aria-label="Bicycle crank. Drag in circles, or use the arrow keys, to move through the photographs."
        aria-valuemin="1"
        aria-valuemax="1"
        aria-valuenow="1"
      >
        <svg id="crank-svg" viewBox="0 0 540 420" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="g-steel" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f4f2ed"></stop>
              <stop offset="0.55" stop-color="#cfcbc2"></stop>
              <stop offset="1" stop-color="#9c978d"></stop>
            </linearGradient>
            <linearGradient id="g-anod" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#3b3a37"></stop>
              <stop offset="1" stop-color="#121211"></stop>
            </linearGradient>
            <linearGradient id="g-graphite" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4a4844"></stop>
              <stop offset="1" stop-color="#1c1b1a"></stop>
            </linearGradient>
            <filter id="f-shadow" x="-10%" y="-10%" width="120%" height="130%">
              <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#1a1a1a" flood-opacity="0.16"></feDropShadow>
            </filter>
          </defs>
          <rect width="540" height="420" fill="transparent"></rect>

          <g filter="url(#f-shadow)">
            <!-- the frame's dropout, which the wheel and derailleur hang from -->
            <line class="hanger" x1={HUB.x - 30} y1={HUB.y - 6} x2={MOUNT.x} y2={MOUNT.y}></line>

            <!-- cassette: every cog drawn, the one under the chain in polished steel -->
            <g id="cassette" transform={`rotate(0 ${HUB.x} ${HUB.y})`}>
              {drawOrder.map((c) => (
                <path class={`cog${c.i === DEFAULT_GEAR ? " is-active" : ""}`} data-i={c.i} d={c.d}></path>
              ))}
              <circle class="hub-shell" cx={HUB.x} cy={HUB.y} r="17"></circle>
              {[0, 1, 2, 3, 4, 5].map((i) => {
                const a = (i / 6) * TAU;
                return <circle class="hub-hole" cx={f(HUB.x + 11 * Math.cos(a))} cy={f(HUB.y + 11 * Math.sin(a))} r="2"></circle>;
              })}
              <circle class="hub-axle" cx={HUB.x} cy={HUB.y} r="5"></circle>
            </g>

            <!-- chainring and spider -->
            <g id="ring" transform={`rotate(0 ${RING.x} ${RING.y})`}>
              <path class="ring" d={ringD} fill-rule="evenodd"></path>
              <circle class="ring-bevel" cx={RING.x} cy={RING.y} r={f(RING_R - 12)}></circle>
              {spiderArms.map((p) => (
                <>
                  <line class="spider" x1={RING.x} y1={RING.y} x2={f(p.x)} y2={f(p.y)}></line>
                  <circle class="bolt" cx={f(p.x)} cy={f(p.y)} r="3.2"></circle>
                </>
              ))}
              <circle class="spider-hub" cx={RING.x} cy={RING.y} r="21"></circle>
            </g>

            <!-- derailleur: hanger, parallelogram, cage, jockey wheels -->
            <g id="derailleur">
              <path id="der-links" class="links" d={linksPath(der0.knuckle)}></path>
              <circle class="body" cx={MOUNT.x} cy={MOUNT.y} r="12"></circle>
              <circle class="bolt" cx={MOUNT.x} cy={MOUNT.y} r="3.4"></circle>
              <circle id="der-knuckle" class="body" cx={f(der0.knuckle.x)} cy={f(der0.knuckle.y)} r="9"></circle>
              <path id="der-cage" class="cage" d={cagePath(der0.upper, der0.lower, PULLEY_R + 6)}></path>
              <g id="pulley-up" transform={`translate(${f(der0.upper.x)} ${f(der0.upper.y)})`}>
                <path class="pulley" d={pulleyD}></path><circle class="pulley-hub" r="4"></circle>
              </g>
              <g id="pulley-lo" transform={`translate(${f(der0.lower.x)} ${f(der0.lower.y)})`}>
                <path class="pulley" d={pulleyD}></path><circle class="pulley-hub" r="4"></circle>
              </g>
            </g>

            <!-- chain: dark outer plates, lighter inner plates, bright rollers -->
            <path id="chain-base" class="chain-base" d={chain0}></path>
            <path id="chain-plates" class="chain-plates" d={chain0}></path>
            <path id="chain-rollers" class="chain-rollers" d={chain0}></path>

            <path id="der-cage-front" class="cage-front" d={cagePath(der0.upper, der0.lower, PULLEY_R + 6)}></path>

            <!-- crank arm and pedal ride on top of everything -->
            <g id="crank" transform={`rotate(0 ${RING.x} ${RING.y})`}>
              <path class="arm" d={armD}></path>
              <circle class="arm-cap" cx={RING.x} cy={RING.y} r="8"></circle>
              <g id="pedal" transform={`rotate(0 ${RING.x + ARM} ${RING.y})`}>
                <rect class="pedal" x={RING.x + ARM - 20} y={RING.y - 8} width="40" height="16" rx="3"></rect>
                <line class="pedal-pin" x1={RING.x + ARM - 13} y1={RING.y} x2={RING.x + ARM + 13} y2={RING.y}></line>
              </g>
            </g>
          </g>

          <text class="lbl" x={RING.x} y="404" text-anchor="middle">Chainring &middot; {RING_TEETH}T</text>
          <text class="lbl" x={HUB.x} y="28" text-anchor="middle">Cassette &middot; 10&ndash;51T</text>
          <text class="lbl" x="530" y="404" text-anchor="end">Rear derailleur</text>
        </svg>
        <span class="crank-pulse" aria-hidden="true"></span>
      </div>

      <div class="crank-shifter" aria-label="Gears">
        <button type="button" class="shift" id="btn-easier" aria-label="Shift to an easier gear">
          <span aria-hidden="true">&larr;</span> Easier
        </button>
        <div class="crank-picker" id="picker" role="group" aria-label="Pick a gear, 1 is the easiest">
          {CASSETTE.map((teeth, i) => (
            <button
              type="button"
              data-i={i}
              aria-pressed={String(i === DEFAULT_GEAR)}
              aria-label={`Gear ${i + 1}, ${teeth} tooth cog`}
              style={`--h:${(teeth / CASSETTE[0]) * 100}%`}
            >
              <i></i><span>{teeth}</span>
            </button>
          ))}
        </div>
        <button type="button" class="shift" id="btn-harder" aria-label="Shift to a harder gear">
          Harder <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <dl class="crank-gear" aria-live="polite">
        <div><dt>Gear</dt><dd><output id="gear-no">{DEFAULT_GEAR + 1}</output> of {CASSETTE.length}</dd></div>
        <div><dt>Teeth</dt><dd>{RING_TEETH} &times; <output id="gear-cog">{CASSETTE[DEFAULT_GEAR]}</output></dd></div>
        <div><dt>Wheel turns per pedal turn</dt><dd><output id="gear-ratio">{ratio0.toFixed(2)}</output></dd></div>
        <div><dt>Photos per pedal turn</dt><dd><output id="gear-photos">{(ratio0 * 4.5).toFixed(1)}</output></dd></div>
      </dl>

      <div class="crank-controls">
        <button type="button" id="btn-back">Rewind</button>
        <button type="button" id="btn-fwd">Forward</button>
        <button type="button" id="btn-cruise" aria-pressed="false">Auto-pedal</button>
        <span class="crank-rpm">Cadence <output id="rpm">0</output> rpm</span>
      </div>
    </div>

    <div class="crank-spine-wrap">
      <div class="crank-spine" id="spine" aria-hidden="true"></div>
      <div class="crank-years" id="years" aria-hidden="true"></div>
      <p class="crank-hint">
        Each stripe is one photograph, colored by its dominant color. Drag across the strip to jump.
      </p>
    </div>
  </section>

  <noscript>
    <p class="crank-noscript">
      This one needs JavaScript. The same photographs are in the
      <a href="/photography/bicycle-crimes">Bicycle Crimes gallery</a>.
    </p>
  </noscript>

  <section class="crank-lesson" aria-labelledby="lesson-h">
    <h2 id="lesson-h">How gears work</h2>
    <p>
      The chain links the pedals to the back wheel. Count the teeth on the front ring, divide by the
      teeth on the back cog, and you get how many times the wheel turns for one turn of the pedals.
    </p>
    <ul>
      <li><strong>Easy gear, big cog (32 &times; 51):</strong> 0.63 wheel turns per pedal turn. Pedaling is light, so it is the gear for hills, but you go slowly. The photos get big and crawl by.</li>
      <li><strong>Hard gear, small cog (32 &times; 10):</strong> 3.2 wheel turns per pedal turn. Every push is heavy, but you fly. The photos shrink and race past.</li>
      <li><strong>Try it:</strong> turn on Auto-pedal, which keeps your legs at the same speed, then shift. Only the gear changes, and the photos speed up or slow down.</li>
    </ul>
  </section>

  <p class="crank-about">
    How it was made: a Python script (Pillow) reduced 131 originals, 605 MB, to 21 MB of web images,
    stripped their metadata, read each capture date, and pulled a dominant color from every frame.
    The drivetrain is SVG with a flywheel: let go and it coasts. The chain path is recalculated as the derailleur shifts, from the tangent lines between the chainring, the cog, and the two jockey wheels.
  </p>
  <p><a href="/experiments">&larr; All experiments</a></p>
</BaseLayout>

<script>
  import {
    ARM, CASSETTE, DEFAULT_GEAR, HUB, PITCH, PULLEY_R, RING, RING_R, RING_TEETH, TAU,
    cagePath, chainPath, cogRadius, derailleurAt, f, linksPath,
  } from "../../lib/drivetrain";

  type Frame = {
    id: string;
    src: string;
    w: number;
    h: number;
    date: string | null;
    color: string;
    lqip: string;
  };

  const PHOTOS_PER_WHEEL_REV = 4.5; // gear 1 shows about 3 photos per pedal turn, gear 12 about 14
  const MAX_OMEGA = 16; // rad/s, about 150 rpm
  const CRUISE_OMEGA = 4.2; // rad/s, about 40 rpm, the same in every gear
  const SCALE_HARDEST = 0.56; // photo size in gear 12; gear 1 is full size
  const WINDOW = 18; // frames kept decoded on either side of the current one
  const MAX_INFLIGHT = 6;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const $ = <T extends Element>(id: string) => document.getElementById(id) as unknown as T;
  const root = $<HTMLElement>("crank-app");
  const frameEl = $<HTMLElement>("frame");
  const imgEl = $<HTMLImageElement>("frame-img");
  const loadingEl = $<HTMLElement>("loading");
  const capDate = $<HTMLElement>("cap-date");
  const capCount = $<HTMLElement>("cap-count");
  const drive = $<HTMLElement>("drive");
  const svg = $<SVGSVGElement>("crank-svg");
  const ringEl = $<SVGGElement>("ring");
  const crankEl = $<SVGGElement>("crank");
  const pedalEl = $<SVGGElement>("pedal");
  const cassetteEl = $<SVGGElement>("cassette");
  const chainEls = ["chain-base", "chain-plates", "chain-rollers"].map((id) => $<SVGPathElement>(id));
  const [, platesEl, rollersEl] = chainEls;
  const cageEls = [$<SVGPathElement>("der-cage"), $<SVGPathElement>("der-cage-front")];
  const linksEl = $<SVGPathElement>("der-links");
  const knuckleEl = $<SVGCircleElement>("der-knuckle");
  const pulleyUp = $<SVGGElement>("pulley-up");
  const pulleyLo = $<SVGGElement>("pulley-lo");
  const rpmEl = $<HTMLOutputElement>("rpm");
  const spine = $<HTMLElement>("spine");
  const yearsEl = $<HTMLElement>("years");
  const btnBack = $<HTMLButtonElement>("btn-back");
  const btnFwd = $<HTMLButtonElement>("btn-fwd");
  const btnCruise = $<HTMLButtonElement>("btn-cruise");
  const btnEasier = $<HTMLButtonElement>("btn-easier");
  const btnHarder = $<HTMLButtonElement>("btn-harder");
  const pickerBtns = [...document.querySelectorAll<HTMLButtonElement>("#picker button")];
  const cogEls = [...cassetteEl.querySelectorAll<SVGPathElement>(".cog")];
  const out = {
    no: $<HTMLOutputElement>("gear-no"),
    cog: $<HTMLOutputElement>("gear-cog"),
    ratio: $<HTMLOutputElement>("gear-ratio"),
    photos: $<HTMLOutputElement>("gear-photos"),
  };

  let frames: Frame[] = [];
  let n = 0;
  let theta = 0; // total crank angle in radians; clockwise is forward
  let wheel = 0; // total back-wheel angle; this is what moves the photographs
  let omega = 0; // coasting angular velocity of the crank
  let vel = 0; // velocity shown in the readout
  let dragging = false;
  let cruising = false;
  let animTarget: number | null = null;
  let current = -1;
  let running = false;
  let lastT = 0;
  let shownRpm = -1;
  let ticks: HTMLElement[] = [];
  let gear = DEFAULT_GEAR; // index into CASSETTE
  let gearPos = DEFAULT_GEAR; // eases toward gear while the derailleur moves
  let chainUnits = 1; // pathLength / real length, keeps whole links on the loop

  const mod = (a: number, m: number) => ((a % m) + m) % m;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const circDist = (a: number, b: number) => {
    const d = Math.abs(a - b);
    return Math.min(d, n - d);
  };
  const ratio = () => RING_TEETH / CASSETTE[gear];
  // Harder gears carry more momentum, so the flywheel coasts longer.
  const friction = () => 1.5 - 0.8 * (gear / (CASSETTE.length - 1));

  // Every crank movement goes through here, so the wheel always follows the gear.
  function advance(d: number) {
    theta += d;
    wheel += d * ratio();
  }

  // ---------- image cache: a sliding window of decoded frames ----------
  const cache = new Map<number, HTMLImageElement>();
  const ready = new Set<number>();
  const pending = new Set<number>();
  const failed = new Set<number>();
  let inflight = 0;

  function load(i: number): Promise<void> {
    const im = new Image();
    im.decoding = "async";
    im.src = frames[i].src;
    return im
      .decode()
      .then(() => {
        cache.set(i, im);
        ready.add(i);
      })
      .catch(() => {
        failed.add(i);
      });
  }

  function nextCandidate(): number | null {
    const dir = vel < 0 ? -1 : 1; // look further ahead in the direction of travel
    for (let d = 0; d <= WINDOW; d++) {
      for (const sign of [dir, -dir]) {
        const i = mod(current + sign * d, n);
        if (!ready.has(i) && !pending.has(i) && !failed.has(i)) return i;
        if (d === 0) break;
      }
    }
    return null;
  }

  function pump() {
    while (inflight < MAX_INFLIGHT) {
      const i = nextCandidate();
      if (i === null) return;
      pending.add(i);
      inflight++;
      load(i).then(() => {
        pending.delete(i);
        inflight--;
        if (i === current) showImage(i);
        pump();
      });
    }
  }

  function evict() {
    for (const i of [...cache.keys()]) {
      if (circDist(i, current) > WINDOW + 4) {
        cache.delete(i);
        ready.delete(i);
      }
    }
  }

  function showImage(i: number) {
    if (!ready.has(i)) {
      imgEl.style.opacity = "0";
      return;
    }
    imgEl.src = frames[i].src;
    imgEl.style.opacity = "1";
    loadingEl.hidden = true;
  }

  // ---------- frame display ----------
  const fmtDate = (iso: string | null) =>
    iso
      ? new Date(iso).toLocaleDateString("en-US", { month: "long", year: "numeric" })
      : "Undated";

  function setFrame(i: number) {
    current = i;
    const fr = frames[i];
    root.style.setProperty("--tint", fr.color);
    frameEl.style.backgroundImage = `url(${fr.lqip})`;
    const label = `Photograph ${i + 1} of ${n}`;
    imgEl.alt = `${label} from the Bicycle Crimes series, ${fmtDate(fr.date)}`;
    capDate.textContent = fmtDate(fr.date);
    capCount.textContent = `${String(i + 1).padStart(3, "0")} / ${n}`;
    drive.setAttribute("aria-valuenow", String(i + 1));
    drive.setAttribute("aria-valuetext", `${label}, ${fmtDate(fr.date)}`);
    ticks.forEach((t) => t.classList.remove("is-active"));
    ticks[i]?.classList.add("is-active");
    showImage(i);
    evict();
    pump();
  }

  // ---------- drivetrain rendering ----------
  // Redraw the chain and derailleur for the cog under the chain (fractional mid-shift).
  function drawDerailleur() {
    const rc = cogRadius(gearPos);
    const der = derailleurAt(rc);
    const d = chainPath(rc);
    for (const el of chainEls) el.setAttribute("d", d);
    // Round the loop to a whole number of links so the pattern has no seam.
    const real = chainEls[0].getTotalLength();
    const links = Math.max(1, Math.round(real / PITCH));
    for (const el of chainEls) el.setAttribute("pathLength", String(links * PITCH));
    chainUnits = (links * PITCH) / real;
    const cage = cagePath(der.upper, der.lower, PULLEY_R + 6);
    for (const el of cageEls) el.setAttribute("d", cage);
    linksEl.setAttribute("d", linksPath(der.knuckle));
    knuckleEl.setAttribute("cx", f(der.knuckle.x));
    knuckleEl.setAttribute("cy", f(der.knuckle.y));
    pulleyUp.dataset.x = f(der.upper.x);
    pulleyUp.dataset.y = f(der.upper.y);
    pulleyLo.dataset.x = f(der.lower.x);
    pulleyLo.dataset.y = f(der.lower.y);
  }

  function render() {
    if (n === 0) return;
    const deg = (theta * 180) / Math.PI;
    const rot = `rotate(${deg.toFixed(2)} ${RING.x} ${RING.y})`;
    ringEl.setAttribute("transform", rot);
    crankEl.setAttribute("transform", rot);
    pedalEl.setAttribute("transform", `rotate(${(-deg).toFixed(2)} ${RING.x + ARM} ${RING.y})`);
    cassetteEl.setAttribute("transform", `rotate(${((wheel * 180) / Math.PI).toFixed(2)} ${HUB.x} ${HUB.y})`);

    // Chain travel in SVG units: the chainring's pitch radius times the crank angle.
    const s = theta * RING_R;
    platesEl.style.strokeDashoffset = String(-s * chainUnits);
    rollersEl.style.strokeDashoffset = String((-s - PITCH * 0.8) * chainUnits);
    const pulleyDeg = ((s / PULLEY_R) * 180) / Math.PI;
    pulleyUp.setAttribute("transform", `translate(${pulleyUp.dataset.x} ${pulleyUp.dataset.y}) rotate(${(-pulleyDeg).toFixed(2)})`);
    pulleyLo.setAttribute("transform", `translate(${pulleyLo.dataset.x} ${pulleyLo.dataset.y}) rotate(${pulleyDeg.toFixed(2)})`);

    const idx = mod(Math.floor((wheel / TAU) * PHOTOS_PER_WHEEL_REV), n);
    if (idx !== current) setFrame(idx);

    const rpm = Math.round((Math.abs(vel) * 60) / TAU);
    if (rpm !== shownRpm) {
      shownRpm = rpm;
      rpmEl.textContent = String(rpm);
    }
  }

  // ---------- gears ----------
  function setGear(g: number) {
    g = clamp(g, 0, CASSETTE.length - 1);
    if (g === gear) return;
    gear = g;
    const r = ratio();
    out.no.textContent = String(g + 1);
    out.cog.textContent = String(CASSETTE[g]);
    out.ratio.textContent = r.toFixed(2);
    out.photos.textContent = (r * PHOTOS_PER_WHEEL_REV).toFixed(1);
    pickerBtns.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.i) === g)));
    cogEls.forEach((c) => c.classList.toggle("is-active", Number(c.dataset.i) === g));
    btnEasier.disabled = g === 0;
    btnHarder.disabled = g === CASSETTE.length - 1;
    // Easy gears show the photographs big; hard gears shrink them.
    root.style.setProperty("--photo-scale", (1 - (1 - SCALE_HARDEST) * (g / (CASSETTE.length - 1))).toFixed(3));
    root.classList.add("is-used");
    if (reduceMotion) {
      gearPos = g;
      drawDerailleur();
      render();
    } else kick();
  }

  // ---------- motion loop (runs only while something is moving) ----------
  function tick(now: number) {
    const dt = clamp((now - lastT) / 1000, 0.001, 0.05);
    lastT = now;

    if (gearPos !== gear) {
      gearPos += (gear - gearPos) * (1 - Math.exp(-11 * dt));
      if (Math.abs(gear - gearPos) < 0.004) gearPos = gear;
      drawDerailleur();
    }

    if (dragging) {
      // the pointer drives the crank; just keep the loop alive for the shift
    } else if (animTarget !== null) {
      const diff = animTarget - theta;
      if (Math.abs(diff) < 0.002) {
        advance(diff);
        animTarget = null;
      } else {
        advance(diff * (1 - Math.exp(-16 * dt)));
      }
      vel = 0;
    } else if (cruising) {
      omega += (CRUISE_OMEGA - omega) * (1 - Math.exp(-3 * dt));
      advance(omega * dt);
      vel = omega;
    } else {
      omega *= Math.exp(-friction() * dt);
      if (Math.abs(omega) < 0.04) omega = 0;
      advance(omega * dt);
      vel = omega;
    }
    render();

    const moving = animTarget !== null || cruising || omega !== 0;
    if ((moving && !dragging) || gearPos !== gear) {
      requestAnimationFrame(tick);
    } else {
      running = false;
      if (!dragging) {
        vel = 0;
        render();
      }
    }
  }

  function kick() {
    if (running) return;
    running = true;
    lastT = performance.now();
    requestAnimationFrame(tick);
  }

  function setCruise(on: boolean) {
    cruising = on && !reduceMotion;
    btnCruise.setAttribute("aria-pressed", String(cruising));
    btnCruise.classList.toggle("is-on", cruising);
    if (cruising) {
      animTarget = null;
      kick();
    }
  }

  // Move the wheel to the middle of the photograph `dir` steps away.
  function stepBy(dir: number) {
    setCruise(false);
    omega = 0;
    const per = TAU / PHOTOS_PER_WHEEL_REV;
    const target = (Math.floor(wheel / per) + dir + 0.5) * per;
    const dTheta = (target - wheel) / ratio();
    if (reduceMotion) {
      advance(dTheta);
      render();
    } else {
      animTarget = theta + dTheta;
      kick();
    }
  }

  function seek(i: number) {
    setCruise(false);
    animTarget = null;
    omega = 0;
    vel = 0;
    wheel = ((clamp(i, 0, n - 1) + 0.5) * TAU) / PHOTOS_PER_WHEEL_REV;
    render();
  }

  // Capture keeps a drag alive when the pointer leaves the element. It can
  // throw if the browser no longer recognizes the pointer, so never let that
  // abort the handler: the drag still works without it.
  function capture(el: Element, id: number) {
    try {
      el.setPointerCapture(id);
    } catch {
      /* drag continues without capture */
    }
  }

  // ---------- dragging the crank ----------
  let lastAngle = 0;
  let lastMoveT = 0;
  let emaVel = 0;

  function pointerAngle(e: PointerEvent) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return 0;
    const c = new DOMPoint(RING.x, RING.y).matrixTransform(ctm);
    return Math.atan2(e.clientY - c.y, e.clientX - c.x);
  }

  svg.addEventListener("pointerdown", (e) => {
    if (n === 0) return;
    e.preventDefault();
    capture(svg, e.pointerId);
    dragging = true;
    setCruise(false);
    animTarget = null;
    omega = 0;
    emaVel = 0;
    lastAngle = pointerAngle(e);
    lastMoveT = performance.now();
    root.classList.add("is-used");
    drive.focus({ preventScroll: true });
  });

  svg.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const a = pointerAngle(e);
    let delta = a - lastAngle;
    if (delta > Math.PI) delta -= TAU;
    if (delta < -Math.PI) delta += TAU;
    lastAngle = a;
    const now = performance.now();
    const dt = Math.max(0.001, (now - lastMoveT) / 1000);
    lastMoveT = now;
    emaVel = 0.55 * emaVel + 0.45 * (delta / dt);
    vel = emaVel;
    advance(delta);
    render();
  });

  function release(e: PointerEvent) {
    if (!dragging) return;
    dragging = false;
    try { svg.releasePointerCapture(e.pointerId); } catch { /* not captured */ }
    const stale = performance.now() - lastMoveT > 90;
    omega = reduceMotion || stale ? 0 : clamp(emaVel, -MAX_OMEGA, MAX_OMEGA);
    if (Math.abs(omega) < 0.5) omega = 0;
    if (omega !== 0) kick();
    else {
      vel = 0;
      render();
    }
  }
  svg.addEventListener("pointerup", release);
  svg.addEventListener("pointercancel", release);

  // ---------- keyboard and buttons ----------
  drive.addEventListener("keydown", (e) => {
    if (n === 0) return;
    const pedalTurn = Math.max(1, Math.round(ratio() * PHOTOS_PER_WHEEL_REV));
    const keys: Record<string, () => void> = {
      ArrowRight: () => stepBy(1),
      ArrowUp: () => stepBy(1),
      ArrowLeft: () => stepBy(-1),
      ArrowDown: () => stepBy(-1),
      PageUp: () => stepBy(pedalTurn),
      PageDown: () => stepBy(-pedalTurn),
      Home: () => seek(0),
      End: () => seek(n - 1),
      " ": () => setCruise(!cruising),
      "[": () => setGear(gear - 1),
      "]": () => setGear(gear + 1),
      "-": () => setGear(gear - 1),
      "=": () => setGear(gear + 1),
    };
    const action = keys[e.key];
    if (action) {
      e.preventDefault();
      root.classList.add("is-used");
      action();
    }
  });

  btnBack.addEventListener("click", () => stepBy(-1));
  btnFwd.addEventListener("click", () => stepBy(1));
  btnCruise.addEventListener("click", () => {
    root.classList.add("is-used");
    setCruise(!cruising);
  });
  btnEasier.addEventListener("click", () => setGear(gear - 1));
  btnHarder.addEventListener("click", () => setGear(gear + 1));
  pickerBtns.forEach((b) => b.addEventListener("click", () => setGear(Number(b.dataset.i))));
  if (reduceMotion) {
    btnCruise.disabled = true;
    btnCruise.title = "Auto-pedal is off because your device asks for reduced motion.";
  }

  // ---------- the color spine ----------
  function buildSpine() {
    spine.textContent = "";
    ticks = frames.map((fr) => {
      const t = document.createElement("i");
      t.style.background = fr.color;
      spine.appendChild(t);
      return t;
    });

    const seekFromEvent = (e: PointerEvent) => {
      const r = spine.getBoundingClientRect();
      seek(Math.floor(((e.clientX - r.left) / r.width) * n));
    };
    let scrubbing = false;
    spine.addEventListener("pointerdown", (e) => {
      scrubbing = true;
      capture(spine, e.pointerId);
      root.classList.add("is-used");
      seekFromEvent(e);
    });
    spine.addEventListener("pointermove", (e) => scrubbing && seekFromEvent(e));
    const end = (e: PointerEvent) => {
      scrubbing = false;
      try { spine.releasePointerCapture(e.pointerId); } catch { /* not captured */ }
    };
    spine.addEventListener("pointerup", end);
    spine.addEventListener("pointercancel", end);
  }

  // Year labels, thinned so they never overlap at narrow widths.
  function layoutYears() {
    yearsEl.textContent = "";
    if (n === 0) return;
    const width = spine.getBoundingClientRect().width || 1;
    let lastX = -Infinity;
    let lastKey = "";
    frames.forEach((fr, i) => {
      const key = fr.date ? fr.date.slice(0, 4) : "undated";
      if (key === lastKey) return;
      lastKey = key;
      const x = (i / n) * width;
      if (x - lastX < 38) return;
      lastX = x;
      const s = document.createElement("span");
      s.textContent = key;
      s.style.left = `${(i / n) * 100}%`;
      yearsEl.appendChild(s);
    });
  }

  // ---------- boot ----------
  root.style.setProperty("--photo-scale", (1 - (1 - SCALE_HARDEST) * (gear / (CASSETTE.length - 1))).toFixed(3));
  drawDerailleur();
  fetch("/crank/manifest.json")
    .then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    })
    .then((m: { frames: Frame[] }) => {
      frames = m.frames;
      n = frames.length;
      drive.setAttribute("aria-valuemax", String(n));
      buildSpine();
      layoutYears();
      new ResizeObserver(layoutYears).observe(spine);
      wheel = (0.5 * TAU) / PHOTOS_PER_WHEEL_REV;
      current = -1;
      render();
      root.dataset.state = "ready";
    })
    .catch(() => {
      loadingEl.textContent = "Couldn't load the photographs. Reload to try again.";
    });
</script>

