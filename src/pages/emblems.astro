---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isSectionVisible } from "../lib/settings";

if (!(await isSectionVisible(env?.DB, "emblems"))) {
  return Astro.rewrite("/404");
}

const emblems: { image: string; alt: string; caption: string }[] = [
  {
    image: "/emblem-the-machine.png",
    alt: "An empty rain-soaked field under floodlights, a dark vacant stage, and a single lit vending machine among scattered newspapers",
    caption:
      "the podium is empty, the floodlights are on, and the only thing still running is the machine that takes your money.",
  },
  {
    image: "/cartoon-the-invoice.png",
    alt: "A man alone at a laptop in an endless dark grid of desks, a small lit institution on the distant horizon",
    caption:
      "I found out what they bill for me on a Tuesday, by accident, off a spreadsheet somebody left open. Four times what I take home. I waited all afternoon to feel robbed, which is at least a clean feeling, and it never came. What came was worse: if I had done nothing that day, the invoice would have gone out the same. The gap between my wage and my price isn't theft. It's a rounding error.\n\nA steelworker knows what he made. He can put a hand on it. I make files. Files on a server in a county I'll never visit, sentences chopped into packets and shot under an ocean, reassembled by a protocol with no opinion on the words, arriving as a document somebody opens for ninety seconds and forwards. The file becomes a number, the number pays the mortgage. The man who poured that slab could find it in the dark. I couldn't tell you where last quarter's work is stored, or whether it still exists, and in three years nobody has asked.",
  },
  {
    image: "/cartoon-never-look-up.png",
    alt: "A lit institution on the horizon casting a dark stream down into an endless field of newspaper buildings",
    caption:
      "The building is always on the horizon and always lit, and the men inside it discovered that a country busy examining itself will never once look up.",
  },
  {
    image: "/cartoon-the-confessional.png",
    alt: "A pristine institution on a hill draining a dark stream down into a city where people wait in line",
    caption:
      "It was the neatest theft in the republic's history: they took class, which is a thing you can count, and swapped it for identity, which is a thing you can only confess, and then charged tuition for the confessional.",
  },
  {
    image: "/emblem-the-cause.png",
    alt: "A vast shadowed figure looming over a torch-lit crowd streaming toward a single glowing doorway",
    caption:
      "I've watched enough of these up close to know the failure mode: paid staff start outnumbering true believers, the mission gets vaguer while the fundraising gets sharper. Doesn't mean every cause ends there. It means those are the symptoms I watch for.",
  },
  {
    image: "/emblem-the-roots.png",
    alt: "A white-haired man sits rooted to his chair before a small monitor in a vast dark warehouse where others move boxes",
    caption:
      "Mailer called it a law of life, so cruel and so just: grow, or pay more for remaining the same. It hit me like a ton of bricks, because by the time I read it I could already count what standing still had cost me. I printed it on my children's walls. I'd rather they learn it from paint than from the bill.",
  },
  {
    image: "/emblem-the-spectator.png",
    alt: "A man alone on a couch in a dim living room, his face washed out by the glow of a laptop screen",
    caption:
      "Twentieth-century man's natural role was anxiety, says Mailer. He was anxious about what the machines might someday do. Twenty-first-century man watches them do it in real time, on a screen he pays for monthly. His natural role is spectator at his own replacement.",
  },
];
---

<BaseLayout title="Emblems" description="Editorial illustrations and the lines that go with them." wide>
  <h1>Emblems</h1>
  <p class="lede">Images and the lines that go with them.</p>
  <p class="emblems-note">
    All the words on this page are mine. The images are made with Midjourney, which
    I've been training toward a specific aesthetic. I do enjoy them. The pictures are
    AI-generated. The text is not.
  </p>

  <div class="emblems-list">
    {emblems.map((e) => {
      const paragraphs = e.caption.split("\n\n");
      const isEssay = paragraphs.length > 1;
      return (
        <figure class="emblem-card">
          <img src={e.image} alt={e.alt} loading="lazy" />
          <figcaption class={`emblem-card__caption ${isEssay ? "emblem-card__caption--essay" : ""}`}>
            {paragraphs.map((p) => <p>{p}</p>)}
          </figcaption>
        </figure>
      );
    })}
  </div>
</BaseLayout>

<style>
  .emblems-note {
    max-width: var(--measure);
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0.75rem 0 0;
  }

  .emblems-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    max-width: 46rem;
    margin: 2rem auto 0;
  }

  .emblem-card {
    margin: 0;
  }

  .emblem-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    border: 1px solid #e8e8e6;
  }

  .emblem-card__caption {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    color: var(--color-ink);
  }

  .emblem-card__caption p {
    margin: 0 0 0.75rem;
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-align: center;
  }

  .emblem-card__caption p:last-child {
    margin-bottom: 0;
  }

  /* Longer, essay-length captions read better as left-aligned prose. */
  .emblem-card__caption--essay p {
    font-style: normal;
    font-size: 1rem;
    line-height: 1.7;
    text-align: left;
    max-width: 38rem;
    margin-left: auto;
    margin-right: auto;
  }
</style>
